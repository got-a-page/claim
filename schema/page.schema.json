{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://got-a.page/schema/page.schema.json",
  "title": "got-a.page page claim",
  "description": "One JSON file per subdomain. The filename (without .json) is the subdomain.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "owner"],
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["point", "instant"],
      "description": "point = bring your own hosting via DNS records. instant = we render a page for you."
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github"],
      "properties": {
        "github": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,37}[a-zA-Z0-9])?$",
          "description": "GitHub username of the page owner. Must match the PR author for new pages."
        },
        "contact": {
          "type": "string",
          "maxLength": 120,
          "description": "Optional public contact (email or URL) shown to maintainers only for point-mode DNS issues."
        }
      }
    },
    "purpose": {
      "type": "string",
      "maxLength": 200,
      "description": "One line about what lives at this address."
    },
    "showcase": {
      "type": "boolean",
      "default": false,
      "description": "Opt in to the Wall of Pages gallery on got-a.page."
    },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "description": "point mode only. DNS records for your subdomain.",
      "properties": {
        "CNAME": { "type": "string", "maxLength": 253 },
        "A": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 8 },
        "AAAA": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 8 },
        "TXT": { "type": "array", "items": { "type": "string", "maxLength": 512 }, "minItems": 1, "maxItems": 8 }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vercel"
      ],
      "description": "Point mode only. Exact claim-bound Vercel verification value. Maintainer review required; published at _vercel.got-a.page.",
      "properties": {
        "vercel": {
          "type": "string",
          "maxLength": 280,
          "pattern": "^vc-domain-verify=[a-z0-9-]+\\.got-a\\.page,[A-Za-z0-9_-]{1,200}$"
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "description": "instant mode only. Content we render for you.",
      "required": ["type", "title"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["person", "product", "project", "community", "event"]
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "tagline": { "type": "string", "maxLength": 160 },
        "avatar": { "type": "string", "maxLength": 500 },
        "theme": {
          "type": "string",
          "enum": ["sunrise", "lagoon", "forest", "plum", "slate", "ember"],
          "default": "sunrise"
        },
        "links": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 40 },
              "url": { "type": "string", "maxLength": 500 }
            }
          }
        },
        "sections": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["heading"],
            "properties": {
              "heading": { "type": "string", "minLength": 1, "maxLength": 80 },
              "text": { "type": "string", "maxLength": 2000 }
            }
          }
        },
        "product": {
          "type": "object",
          "additionalProperties": false,
          "description": "Extra fields for type=product.",
          "properties": {
            "launchDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "cta": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "url"],
              "properties": {
                "label": { "type": "string", "maxLength": 40 },
                "url": { "type": "string", "maxLength": 500 }
              }
            },
            "features": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 120 } },
            "screenshots": { "type": "array", "maxItems": 4, "items": { "type": "string", "maxLength": 500 } }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "point" } } },
      "then": { "required": ["records"], "not": { "required": ["page"] } }
    },
    {
      "if": { "properties": { "mode": { "const": "instant" } } },
      "then": { "required": ["page"], "not": { "anyOf": [{ "required": ["records"] }, { "required": ["verification"] }] } }
    }
  ]
}
